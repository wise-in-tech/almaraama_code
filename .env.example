# Copy to .env and set strong, unique values. .env is never committed (security baseline: secrets).
# Generate a value with:  openssl rand -base64 32

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

# Migration role: owns the schemas, used by Flyway only.
ALMARAAMA_DB_MIGRATOR_USER=almaraama_migrator
ALMARAAMA_DB_MIGRATOR_PASSWORD=change-me

# Application role: SELECT, INSERT, UPDATE; no DELETE (M2).
ALMARAAMA_DB_APP_USER=almaraama_app
ALMARAAMA_DB_APP_PASSWORD=change-me

# Access-token signing key (RSA 3072, PKCS#8 PEM), outside the repository. Generate it once with:
#   mkdir -p secrets && openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out secrets/jwt-private.pem
#   chmod 644 secrets/jwt-private.pem   (the backend runs as uid 10001 and must read it)
ALMARAAMA_JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem

# Development only (needs SPRING_PROFILES_ACTIVE=dev): this e-mail becomes platform admin and promoteur of a demo
# organization; its "set my password" e-mail arrives in Mailpit, http://127.0.0.1:8025 (ADR-031).
SPRING_PROFILES_ACTIVE=
ALMARAAMA_DEV_INVITE_EMAIL=
ALMARAAMA_DEV_INVITE_PHONE=+213661234567

# Technical logs (ADR-033): ONE switch, INFO (default), DEBUG or TRACE. Never secrets nor personal data in clear.
ALMARAAMA_LOG_LEVEL=INFO

# Account e-mails (ADR-031). Development: the compose service "mailpit" (no TLS). Production: the relay of the host in
# Algeria, TLS required, its password in a secret file.
ALMARAAMA_SMTP_HOST=mailpit
ALMARAAMA_SMTP_PORT=1025
ALMARAAMA_SMTP_USERNAME=
ALMARAAMA_SMTP_PASSWORD_FILE=
ALMARAAMA_SMTP_STARTTLS_REQUIRED=false
ALMARAAMA_MAIL_FROM=no-reply@almaraama.local
# Public address of the web application in the links of the e-mails (never taken from the request).
ALMARAAMA_MAIL_LINK_BASE_URL=http://localhost:5173

# Anti-robot proof of work (ADR-032): HMAC key, 32 characters or more, in a file outside the repository:
#   openssl rand -hex 32 > secrets/altcha-hmac.key && chmod 644 secrets/altcha-hmac.key
ALMARAAMA_ALTCHA_HMAC_KEY_PATH=./secrets/altcha-hmac.key
# Key signing the 5-minute links of stored files (ADR-038): openssl rand -hex 32 > secrets/file-link.key
ALMARAAMA_FILE_LINK_KEY_PATH=./secrets/file-link.key

# Our team (ADR-026): a secret file with one "email;phone" per line. Empty: none.
ALMARAAMA_PLATFORM_ADMIN_EMAILS_FILE=

# Publish the OpenAPI description at /v3/api-docs (dev only).
ALMARAAMA_OPENAPI_ENABLED=false

POSTGRES_PORT=5432
BACKEND_PORT=8080
