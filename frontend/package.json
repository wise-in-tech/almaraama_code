{
  "name": "almaraama-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "almaraama web and mobile application (ADR-024)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/shared/api/schema.d.ts",
    "dev": "pnpm gen:api && vite",
    "dev:mocks": "pnpm gen:api && vite --mode mocks",
    "build": "pnpm gen:api && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm gen:api && tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "pnpm check:texts && pnpm typecheck && pnpm lint && pnpm test && vite build",
    "sync:texts": "node scripts/texts.mjs sync",
    "check:texts": "node scripts/texts.mjs check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "altcha": "2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.0.1",
    "libphonenumber-js": "1.13.15",
    "openapi-fetch": "^0.17.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^18.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
