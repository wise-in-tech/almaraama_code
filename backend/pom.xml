<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.almaraama</groupId>
    <artifactId>almaraama-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>almaraama-backend</name>
    <description>Facility and maintenance management platform: modular monolith, one Maven module per bounded
        context (ADR-002, ADR-023).</description>

    <modules>
        <module>platform/shared</module>
        <module>platform/spreadsheet</module>
        <module>modules/identity</module>
        <module>modules/sites</module>
        <module>modules/customization</module>
        <module>modules/files</module>
        <module>modules/workflow</module>
        <module>modules/membership</module>
        <module>modules/assets</module>
        <module>modules/maintenance</module>
        <module>modules/preventive</module>
        <module>modules/notification</module>
        <module>modules/audit</module>
        <module>platform/app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-modulith.version>2.1.2</spring-modulith.version>
        <springdoc.version>3.2.0</springdoc.version>
        <archunit.version>1.5.1</archunit.version>
        <bouncycastle.version>1.87</bouncycastle.version>
        <libphonenumber.version>9.0.42</libphonenumber.version>
        <altcha.version>2.1.1</altcha.version>
        <poi.version>5.5.1</poi.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- Argon2id for password hashing (identity, ADR-030), MIT-style Bouncy Castle licence -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!-- Anti-robot proof of work on public forms (app, ADR-032), MIT licence -->
            <dependency>
                <groupId>org.altcha</groupId>
                <artifactId>altcha</artifactId>
                <version>${altcha.version}</version>
            </dependency>

            <!-- Phone numbers of every country (identity, ADR-028), Apache 2.0 licence -->
            <dependency>
                <groupId>com.googlecode.libphonenumber</groupId>
                <artifactId>libphonenumber</artifactId>
                <version>${libphonenumber.version}</version>
            </dependency>

            <!-- Excel imports and templates (platform/spreadsheet, ADR-027), Apache 2.0 licence -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <!-- POI and commons-compress ask for two versions of commons-io: keep POI's (dependency convergence) -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.21.0</version>
            </dependency>
            <!-- Internal artifacts -->
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>spreadsheet</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>identity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>identity-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>sites-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>sites-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>customization-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>customization-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>files-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>files-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>workflow-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>workflow-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>membership-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>membership-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>assets-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>assets-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>maintenance-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>maintenance-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>preventive-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>preventive-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>notification-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>notification-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>audit-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.almaraama</groupId>
                <artifactId>audit-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>Java 25 is required (ADR-002). Build with ./mvnw on a JDK 25, or through Docker.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence/>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Mockito's agent and Testcontainers' JNA, allowed explicitly on JDK 25. -->
                    <argLine>-XX:+EnableDynamicAgentLoading --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
