<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.almaraama</groupId>
        <artifactId>customization</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>customization-impl</artifactId>
    <name>customization-impl</name>
    <description>Implementation of customization: domain, application and adapters (hexagonal).
        Depends on its own api, on shared, and on the api artifacts of the modules it is allowed to use.
        Technology libraries (JPA, web, SMS, storage...) are added here only when an adapter needs them.</description>

    <dependencies>
        <dependency>
            <groupId>com.almaraama</groupId>
            <artifactId>customization-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.almaraama</groupId>
            <artifactId>shared</artifactId>
        </dependency>
        <dependency>
            <groupId>com.almaraama</groupId>
            <artifactId>identity-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-api</artifactId>
        </dependency>

        <!-- Adapters of the text dictionary (ADR-029): persistence, web, JSON of the delivered texts. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
