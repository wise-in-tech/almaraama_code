        </dependency>
        <dependency>
            <groupId>com.almaraama</groupId>
            <artifactId>assets-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.almaraama</groupId>
            <artifactId>files-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.almaraama</groupId>
            <artifactId>workflow-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.almaraama</groupId>
            <artifactId>customization-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-api</artifactId>
        </dependency>
    </dependencies>
</project>
