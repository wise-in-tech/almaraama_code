        <artifactId>maintenance</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>maintenance-impl</artifactId>
    <name>maintenance-impl</name>
    <description>Implementation of maintenance: domain, application and adapters (hexagonal).
